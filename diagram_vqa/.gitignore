# ─────────────────────────────────────────────────────────────
# Секреты — НИКОГДА не коммитить (в .env лежит OPENAI_API_KEY)
# ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Виртуальные окружения (venv проекта лежит в ../.venv, но на всякий случай)
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/
*-checkpoint.ipynb

# ─────────────────────────────────────────────────────────────
# ML-артефакты и тяжёлые файлы (чекпоинты, кэши, эмбеддинги)
# ─────────────────────────────────────────────────────────────
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.onnx
*.pkl
*.npz
*.npy
*.h5

# Кэши сегментации / признаков
*_cache/
_cache*/

# Логи и временные дампы
*.log
*.tmp

# ─────────────────────────────────────────────────────────────
# runs/ — 3.9 GB выходов: тяжёлое игнорим, оставляем только метрики
#   (паттерн: игнор содержимого, но разрешаем спуск по папкам и metrics-json)
# ─────────────────────────────────────────────────────────────
runs/**
!runs/**/
!runs/**/metrics_all.json
!runs/**/metrics.json

# ─────────────────────────────────────────────────────────────
# Черновики/тулзы (временные скрипты отладки)
# ─────────────────────────────────────────────────────────────
_run_*.py
_gen_*.py
_diag_*.py

# ─────────────────────────────────────────────────────────────
# ОС / редакторы
# ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
